flowchart TB

    %% =========================================================
    %% TOP ROW
    %% =========================================================
    PWR[12V DC Jack Connector]:::power
    ANT[GPS Antenna Connector]:::rf
    USB[USB Type C Connector]:::usb
    
    %% Power chain
    SMPS[SMPS]:::power
    LDO[Linear Regulator]:::power

    PWR --> SMPS --> LDO
    UBX[GNSS Module]:::rf
    ANT --> UBX
    USB --> JTAG
    
JTAG[USB Blaster]:::usb

    %% =========================================================
    %% TIMING / CONTROL
    %% =========================================================
    TDC[Time-to-Digital Converter]:::tdc
    DAC[Precision DAC]:::clk
    OCXO[OCXO 10 MHz]:::clk

    FPGA[["<b><font size='+2'>FPGA</font></b><br/>Divider + Control Loop"]]:::fpga

    AMP[Amplifier]:::clk
  


    %% GPS / timing
    UBX -->|1 PPS - GPS| TDC
    FPGA -->|1 PPS - local| TDC
    TDC -->|SPI: time interval| FPGA

    UBX <-->|UART| FPGA

    %% OCXO / control loop
    OCXO -->|10 MHz| FPGA
    OCXO -->|10 MHz ref clock| TDC

    FPGA -->|SPI| DAC
    DAC -->|EFC voltage| OCXO

    OCXO -->|10 MHz| AMP

 

    JTAG <-->|UART| FPGA
    JTAG <-->|JTAG| FPGA 

    %% =========================================================
    %% OUTPUT 1
    %% =========================================================
    subgraph CH1[Output 1]
        direction TB
        FLT1[Driver + Filter]:::clk
        ISO1[Galvanic Isolation]:::iso
        O1[10 MHz Out BNC]:::clk

        FLT1 --> ISO1 --> O1
    end


    %% =========================================================
    %% OUTPUT 2
    %% =========================================================
    subgraph CH2[Output 2]
        direction TB
        FLT2[Driver + Filter]:::clk
        ISO2[Galvanic Isolation]:::iso
        O2[10 MHz Out BNC]:::clk

        FLT2 --> ISO2 --> O2
    end


    %% =========================================================
    %% OUTPUT 3
    %% =========================================================
    subgraph CH3[Output 3]
        direction TB
        FLT3[Driver + Filter]:::clk
        ISO3[Galvanic Isolation]:::iso
        O3[10 MHz Out BNC]:::clk

        FLT3 --> ISO3 --> O3
    end


    %% =========================================================
    %% OUTPUT 4
    %% =========================================================
    subgraph CH4[Output 4]
        direction TB
        TTL[TTL Driver]:::ttl
        PROT[Series R + ESD Protection]:::ttl
        O4[1 PPS Out BNC]:::ttl

        TTL --> PROT --> O4
    end



    %% =========================================================
    %% OUTPUT CONNECTIONS
    %% =========================================================
    AMP --> CH1[Output 1]
    AMP --> CH2[Output 2]
    AMP --> CH3[Output 3]

    FPGA --> CH4[Output 4]


    %% =========================================================
    %% LAYOUT HINTS
    %% =========================================================

    %% Keep power section to the left
    LDO ~~~ TDC


    %% Keep PPS output separate from 10 MHz outputs
    AMP ~~~ TTL


    %% =========================================================
    %% STYLES
    %% =========================================================
    classDef power fill:#fde8e8,stroke:#c0392b
    classDef rf fill:#e8f0fd,stroke:#2c6fbb
    classDef clk fill:#e8fdea,stroke:#2e8b3d
    classDef iso fill:#fff4d6,stroke:#d68910
    classDef ttl fill:#f1e8fd,stroke:#7d3cb5
    classDef tdc fill:#e8fafd,stroke:#1a8a9a
    classDef usb fill:#e8fafd,stroke:#1a8a9a
    classDef fpga fill:#e0e0e0,stroke:#333333,stroke-width:3px,padding:25px